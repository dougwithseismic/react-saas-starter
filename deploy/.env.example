PUBLIC_HOST=accounts.example.com
POSTGRES_PASSWORD=replace-with-a-strong-password
# URL-encode password characters when placing them in this URL.
DATABASE_URL=postgresql://starter:replace-with-a-strong-password@postgres:5432/starter
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Loops API key is server-only. Use published transactional template IDs.
LOOPS_API_KEY=
LOOPS_RESET_PASSWORD_TEMPLATE_ID=
LOOPS_VERIFY_EMAIL_TEMPLATE_ID=
LOOPS_INVITATION_TEMPLATE_ID=
# Optional server analytics.
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Optional browser analytics; these public values are embedded at build time.
VITE_POSTHOG_PROJECT_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
