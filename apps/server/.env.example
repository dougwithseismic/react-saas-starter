DATABASE_URL=postgresql://starter:starter@localhost:5433/starter
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4300
APP_ORIGIN=http://localhost:4300
PORT=4301
NODE_ENV=development
LOG_LEVEL=info

# Loops transactional email. Configure the API key and all three published templates.
# LOOPS_API_KEY=...
# LOOPS_RESET_PASSWORD_TEMPLATE_ID=...
# LOOPS_VERIFY_EMAIL_TEMPLATE_ID=...
# LOOPS_INVITATION_TEMPLATE_ID=...

# Optional server analytics. Disabled when the project key is absent.
# POSTHOG_PROJECT_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# Optional Stripe billing. Billing is switched off until both keys are set. Use test
# mode keys (sk_test_...) until you go live. For local webhooks, `stripe listen`
# prints the whsec_ secret. Price ids are comma separated: Checkout offers the first,
# and older prices listed after it keep existing subscribers on their plan.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...

# Socket IPs or CIDR ranges of trusted proxies, comma separated. Never /0 or client
# ranges. Local Vite proxy uses loopback. Without trust, users share the proxy rate limit.
TRUSTED_PROXY_IPS=127.0.0.1,::1
